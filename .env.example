# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不要把真实密钥提交到 Git

# SQLite 文件位置（相对 backend/ 目录）
DATABASE_URL=sqlite:///./data/app.db

# 时区：所有时间计算都基于这个时区
APP_TIMEZONE=Asia/Shanghai

# OpenAI 兼容接口。留空时：
#   - 按钮式建议（/api/agent/suggest）自动降级为规则版
#   - 对话式 Agent（/api/agent/chat）不挂载，前端面板会提示服务不可用
#
# DeepSeek（默认推荐）：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
#
# 其他兼容服务同理，改 base_url 和 model 即可，代码不用动。
# 同一套配置同时供「按钮式建议」和「对话式 Agent」使用，不会出现两处不一致。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 模型单次调用超时（秒）。DeepSeek 实测 1~1.5s，给 30 足够
LLM_TIMEOUT=30
